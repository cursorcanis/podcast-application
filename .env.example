# Podcast Foundry — environment variable NAMES only. Never put a value here;
# a real .env is gitignored and only ever holds values locally, or set these
# in Windows System Properties -> Environment Variables instead.
#
# Values not set here fall back to the Board-confirmed defaults loaded by
# app/config.py from config/app_config.json (POD-2 configuration document,
# revision 6, 2026-10-02).

# ComfyUI HTTP endpoint. Today unreachable -> screen honestly shows red.
COMFYUI_URL=http://127.0.0.1:8188

# Episode output and share handoff folders (Board-confirmed Windows paths).
OUTPUT_FOLDER=C:\Users\alfre\Desktop\_desktop\_projects\_ComfyUI\output\podcast_foundry
SHARE_LOCATION=C:\Users\alfre\Desktop\_desktop\_projects\_podcast_application\_output_podcast_folder

# Caps and budget (Board-confirmed defaults).
MAX_RENDER_HOURS=3
CHUNK_TIMEOUT_MIN=10
MAX_ATTACHMENT_MB=20
MONTHLY_BUDGET=0

# Email delivery. PAUSED while EMAIL_METHOD is empty: a finished episode is
# copied to SHARE_LOCATION instead of sent, and the UI says so.
#
# The Board chose Gmail SMTP with an app password (POD-33, 2026-10-04). To turn
# delivery ON, copy this file to `.env` (gitignored) and fill in all three:
#
#   EMAIL_METHOD=smtp
#   SMTP_USER=<the gmail address the app password was created on>
#   SMTP_PASS=<the 16-character Google app password, NOT the account password>
#
# App password: https://myaccount.google.com/apppasswords (needs 2-Step
# Verification on). SMTP_HOST / SMTP_PORT default to smtp.gmail.com:587 with
# STARTTLS, so leave them unset for Gmail. SENDER_ADDRESS falls back to
# SMTP_USER, so it needs no value either.
#
# Partial configuration fails loud by design: EMAIL_METHOD set without the
# credentials raises an error naming the missing variables rather than quietly
# reverting to paused. Values live only in a local `.env` or the Windows
# environment -- never here, never in config/app_config.json, never in a log.
EMAIL_METHOD=
# SMTP_USER=
# SMTP_PASS=

# ComfyUI render pipeline (M3). The workflow file's node ids are discovered
# dynamically (app/workflow.py) -- never hardcoded here or in code.
PATH_TO_WORKFLOW_JSON=config/comfyui_workflow.json
RENDER_SECONDS_PER_AUDIO_SECOND=3.83
CHUNK_SECONDS_TARGET_DEFAULT=60